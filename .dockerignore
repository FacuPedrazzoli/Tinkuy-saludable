# ===========================================
# .dockerignore - Frontend (Next.js)
# ===========================================

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build outputs
.next
out
dist
build
*.tsbuildinfo

# Environment files (keep template only)
.env
.env.local
.env.*.local
!.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage
.nyc_output
*.lcov

# Playwright
playwright-report
test-results
*.playwright.*

# Misc
.DS_Store
*.pem
.vercel
.thumbnails
*.swp
*.swo

# Git
.git
.gitignore
.gitattributes

# CI/CD
.github
.gitlab-ci.yml
.travis.yml
.appveyor.yml

# Docs
README.md
CHANGELOG.md
docs
*.md

# IDE
.vscode
.idea
*.swp
*.swo

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# Certs and keys (generate on server)
certs
ssl
*.crt
*.key
*.pem

# Prisma (already generated in builder stage)
prisma/migrations
prisma/dev.db
prisma/dev.db-journal

# Husky and lint-staged
.husky
.lintstagedrc
.lintstagedrc.js
.lintstagedrc.json

# Debug
.npm
.node_repl_history

# Temporary files
tmp
temp
*.tmp
