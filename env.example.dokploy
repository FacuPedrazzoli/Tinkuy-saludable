# =============================================================================
# env.example.dokploy — Tinkuy-saludable (Frontend)
# =============================================================================
# NOTE: .env.example in this repo could not be overwritten (tool permission
# restriction on .env* filenames). This file serves the same purpose.
# Copy it to .env and fill in every value before running.
# Never commit .env to version control.
#
# DEV block  — values for local development (backend running on localhost:4000).
# PROD block — values for the Dokploy environment panel.
#
# IMPORTANT: NEXT_PUBLIC_* vars are baked into the JS bundle at build time.
# Changing them requires a full `docker compose build` — a container restart
# alone will NOT pick up new values.
# =============================================================================


# -----------------------------------------------------------------------------
# BACKEND — GraphQL API URL
# -----------------------------------------------------------------------------
# DEV:  backend docker-compose.override.yml publishes port 4000 to the host
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
# PROD: NEXT_PUBLIC_GRAPHQL_URL=https://api.tinkuy.com.ar/graphql


# -----------------------------------------------------------------------------
# TENANT
# -----------------------------------------------------------------------------
# Backend resolves this value as a tenant slug (and falls back to the single
# active tenant if the header is absent), so the slug "tinkuy" is correct for
# production. UUIDs are NOT required.
# DEV:  use the slug matching your local tenant seed (e.g. "tinkuy")
NEXT_PUBLIC_TENANT_ID=tinkuy
# PROD: NEXT_PUBLIC_TENANT_ID=tinkuy


# -----------------------------------------------------------------------------
# DEFAULT BRANCH (checkout)
# -----------------------------------------------------------------------------
# Must match the branch UUID seeded in the backend database. The seeded default
# branch is 00000000-0000-0000-0000-000000000001. If the backend seed changes,
# update this value to match.
# DEV:
NEXT_PUBLIC_DEFAULT_BRANCH_ID=00000000-0000-0000-0000-000000000001
# PROD: NEXT_PUBLIC_DEFAULT_BRANCH_ID=00000000-0000-0000-0000-000000000001


# -----------------------------------------------------------------------------
# SITE URL — canonical links, OG tags, sitemaps
# -----------------------------------------------------------------------------
# DEV:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# PROD: NEXT_PUBLIC_SITE_URL=https://tinkuy.com.ar


# -----------------------------------------------------------------------------
# MERCADOPAGO — public key (safe to expose in the browser)
# -----------------------------------------------------------------------------
# DEV:  test public key from MP developer dashboard
NEXT_PUBLIC_MP_PUBLIC_KEY=TEST-your-test-public-key
# PROD: NEXT_PUBLIC_MP_PUBLIC_KEY=APP_USR-your-prod-public-key


# -----------------------------------------------------------------------------
# ANALYTICS — optional; leave empty to disable each integration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=


# -----------------------------------------------------------------------------
# AUTH COOKIE ENCRYPTION
# -----------------------------------------------------------------------------
# Used by src/lib/authCrypto.ts to encrypt the auth_user cookie (AES-256-CBC
# via Web Crypto PBKDF2). MUST be a stable secret of 32+ characters.
# This value is baked into the client bundle at build time (NEXT_PUBLIC_*), so
# it MUST be identical between the build environment and runtime — a mismatch
# causes the cookie to be undecipherable and login to silently fail.
# IMPORTANT: replace this placeholder with a real secret and NEVER commit it.
NEXT_PUBLIC_COOKIE_SECRET=change-me-32-bytes-minimum-secret!!


# -----------------------------------------------------------------------------
# OBSERVABILITY
# -----------------------------------------------------------------------------
# DEV:  leave empty to disable Sentry
# PROD: Sentry DSN from the Sentry project settings page (browser DSN)
NEXT_PUBLIC_SENTRY_DSN=
