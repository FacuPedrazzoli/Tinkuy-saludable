# ===========================================
# SITIO
# ===========================================
NEXT_PUBLIC_SITE_URL=https://tinkuy.com.ar
NEXT_PUBLIC_SITE_NAME="Tinkuy - Productos Naturales"

# ===========================================
# GRAPHQL API
# ===========================================
NEXT_PUBLIC_GRAPHQL_URL=https://api.tinkuy.com.ar/graphql

# ===========================================
# SECURITY - Cookie Encryption (must match backend)
# ===========================================
NEXT_PUBLIC_COOKIE_SECRET=change-me-to-exactly-32-random-bytes

# ===========================================
# REDIS (Upstash para serverless o tu propia instancia)
# ===========================================
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# ===========================================
# SENTRY (Error Tracking)
# ===========================================
NEXT_PUBLIC_SENTRY_DSN=https://example@sentry.io/1234567
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# ===========================================
# ANALYTICS
# ===========================================
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_FB_PIXEL_ID=123456789

# ===========================================
# MERCADOPAGO (si se usa desde frontend)
# ===========================================
NEXT_PUBLIC_MP_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ===========================================
# SUPABASE (si se usa desde frontend)
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ===========================================
# DATABASE (Prisma PostgreSQL)
# ===========================================
DATABASE_URL=postgresql://user:password@localhost:5432/tinkuy?schema=public

# ===========================================
# JWT TOKENS (Autenticación)
# ===========================================
ACCESS_TOKEN_SECRET=your-access-token-secret-min-32-chars
REFRESH_TOKEN_SECRET=your-refresh-token-secret-min-32-chars
